# Copy to .env and adjust for your environment.

# Where the running frontend is served.
E2E_BASE_URL=http://localhost:5173

# Where the backend API is reachable (used by the auth fixture to log in).
# Must match the VITE_API_URL the frontend was built with.
# The backend hardcodes app.Run("http://localhost:4000") in Program.cs.
E2E_API_URL=http://localhost:4000

# Verified, non-admin test account.
E2E_USER_EMAIL=e2e.user@mesmer.test
E2E_USER_PASSWORD=e2ePassword123

# Admin test account.
E2E_ADMIN_EMAIL=e2e.admin@mesmer.test
E2E_ADMIN_PASSWORD=e2ePassword123
