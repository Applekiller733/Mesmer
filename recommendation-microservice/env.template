# Local development configuration for the recommendation microservice.
# In AWS these are set by the SAM stack instead (template.yaml).

# --- Database ---
# Local: set DATABASE_URL to a full Postgres connection string.
DATABASE_URL=<connection string>

# AWS / Aurora IAM auth (used when DB_HOST is set; leave unset locally). Mirrors
# the .NET backend. When DB_HOST is present, db.py generates a short-lived RDS
# IAM auth token instead of using DATABASE_URL — no password needed.
# DB_HOST=<aurora endpoint>
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# AWS_REGION=eu-north-1

# --- MusicBrainz User-Agent (set a real contact to avoid throttling) ---
MUSICBRAINZ_USER_AGENT_APP=<app name>
MUSICBRAINZ_USER_AGENT_VERSION=<app version>
MUSICBRAINZ_USER_AGENT_CONTACT=<app contact email>

# --- Backend API (for the librosa audio-fetch fallback) ---
DOTNET_API_BASE_URL=<backend url>
